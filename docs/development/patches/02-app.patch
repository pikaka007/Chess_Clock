new file mode 100644
index 0000000000000000000000000000000000000000..e7d3cf88aff49d93db894b9f0c3ad74980244426
--- /dev/null
+++ b/app/src/main/java/com/bara/chessclock/core/TimeControl.kt
@@ -0,0 +1,50 @@
+package com.bara.chessclock.core
+
+/**
+ * Time control: base time per side plus a Fischer increment granted per completed move.
+ *
+ * The increment is added to the side that *finished* a move (i.e. the side being stopped),
+ * which is the rule the UI, the demo and the tests all use.
+ */
+data class TimeControl(
+    val baseMs: Long,
+    val incrementMs: Long,
+) {
+    init {
+        require(baseMs in MIN_BASE_MS..MAX_BASE_MS) { "baseMs out of range: $baseMs" }
+        require(incrementMs in MIN_INCREMENT_MS..MAX_INCREMENT_MS) { "incrementMs out of range: $incrementMs" }
+    }
+
+    val label: String
+        get() = buildString {
+            append(ClockFormat.mmss(baseMs))
+            if (incrementMs > 0) append(" +").append(incrementMs / 1000).append("s")
+        }
+
+    companion object {
+        /** Lower bound keeps a game meaningfully playable; 5 s is the shortest control we accept. */
+        const val MIN_BASE_MS: Long = 5_000
+        const val MAX_BASE_MS: Long = 60 * 60_000L
+        const val MIN_INCREMENT_MS: Long = 0
+        const val MAX_INCREMENT_MS: Long = 60_000
+
+        /** AppForge's "1 min" preset. Zero increment by design. */
+        val PRESET_1_MIN = TimeControl(60_000, 0)
+
+        /** The course-required Fischer preset: 3 minutes + 2 s per completed move. */
+        val PRESET_3_PLUS_2 = TimeControl(180_000, 2_000)
+
+        val PRESET_5_MIN = TimeControl(300_000, 0)
+        val PRESET_10_MIN = TimeControl(600_000, 0)
+
+        val PRESETS: List<TimeControl> = listOf(PRESET_1_MIN, PRESET_3_PLUS_2, PRESET_5_MIN, PRESET_10_MIN)
+
+        /** @return null when either value is out of range, instead of throwing. */
+        fun createOrNull(baseMs: Long, incrementMs: Long): TimeControl? =
+            if (baseMs in MIN_BASE_MS..MAX_BASE_MS && incrementMs in MIN_INCREMENT_MS..MAX_INCREMENT_MS) {
+                TimeControl(baseMs, incrementMs)
+            } else {
+                null
+            }
+    }
+}
diff --git a/app/src/main/java/com/bara/chessclock/core/TimeControlDraft.kt b/app/src/main/java/com/bara/chessclock/core/TimeControlDraft.kt
new file mode 100644
index 0000000000000000000000000000000000000000..275200abaad2bd059e858735d55fab924784e07e
--- /dev/null
+++ b/app/src/main/java/com/bara/chessclock/core/TimeControlDraft.kt
@@ -0,0 +1,92 @@
+package com.bara.chessclock.core
+
+/**
+ * Text-field state of the settings screen, kept pure so the validation rules are unit tested
+ * instead of being duplicated in a Composable.
+ *
+ * Rules (docs/acceptance.md §C):
+ *  - base duration must be filled with digits: minutes 0..60, seconds 0..59
+ *  - total base duration 5 s .. 60 min
+ *  - increment 0..60 s; an empty increment field means "no increment" (a normal way to play)
+ */
+data class TimeControlDraft(
+    val minutesText: String,
+    val secondsText: String,
+    val incrementText: String,
+) {
+
+    sealed interface Validation {
+        data class Valid(val control: TimeControl) : Validation
+        data class Invalid(val message: String) : Validation
+    }
+
+    fun validate(): Validation {
+        val minutes = minutesText.trim()
+        val seconds = secondsText.trim()
+        val increment = incrementText.trim()
+
+        if (minutes.isEmpty() && seconds.isEmpty()) {
+            return Validation.Invalid("请填写基础时长（例如 5 分 0 秒）")
+        }
+        val minutesValue = minutes.ifEmpty { "0" }.toIntOrNull()
+            ?: return Validation.Invalid("分钟只能填数字")
+        val secondsValue = seconds.ifEmpty { "0" }.toIntOrNull()
+            ?: return Validation.Invalid("秒只能填数字")
+        if (minutesValue < 0 || secondsValue < 0) {
+            return Validation.Invalid("时长不能为负数")
+        }
+        if (minutesValue > MAX_MINUTES) {
+            return Validation.Invalid("基础时长最多 $MAX_MINUTES 分钟")
+        }
+        if (secondsValue > 59) {
+            return Validation.Invalid("秒数应在 0 到 59 之间")
+        }
+        val baseMs = minutesValue * 60_000L + secondsValue * 1_000L
+        if (baseMs < TimeControl.MIN_BASE_MS) {
+            return Validation.Invalid("基础时长至少 ${TimeControl.MIN_BASE_MS / 1000} 秒")
+        }
+
+        val incrementValue = increment.ifEmpty { "0" }.toIntOrNull()
+            ?: return Validation.Invalid("每步加秒只能填数字")
+        if (incrementValue < 0) {
+            return Validation.Invalid("每步加秒不能为负数")
+        }
+        if (incrementValue > MAX_INCREMENT_SECONDS) {
+            return Validation.Invalid("每步加秒最多 $MAX_INCREMENT_SECONDS 秒")
+        }
+
+        val control = TimeControl.createOrNull(baseMs, incrementValue * 1000L)
+            ?: return Validation.Invalid("时长超出允许范围")
+        return Validation.Valid(control)
+    }
+
+    /** Human summary shown above the start button, e.g. `双方各 5:00，无加秒`. */
+    fun summary(): String {
+        return when (val result = validate()) {
+            is Validation.Invalid -> result.message
+            is Validation.Valid -> describe(result.control)
+        }
+    }
+
+    companion object {
+        const val MAX_MINUTES = 60
+        const val MAX_INCREMENT_SECONDS = 60
+
+        fun from(control: TimeControl): TimeControlDraft = TimeControlDraft(
+            minutesText = (control.baseMs / 60_000).toString(),
+            secondsText = (control.baseMs % 60_000 / 1000).toString(),
+            incrementText = (control.incrementMs / 1000).toString(),
+        )
+
+        val EMPTY = TimeControlDraft("", "", "0")
+
+        fun describe(control: TimeControl): String {
+            val base = ClockFormat.mmss(control.baseMs)
+            return if (control.incrementMs == 0L) {
+                "双方各 $base，不加秒"
+            } else {
+                "双方各 $base，每走完一步 +${control.incrementMs / 1000} 秒"
+            }
+        }
+    }
+}
diff --git a/app/src/main/java/com/bara/chessclock/data/AndroidAdapters.kt b/app/src/main/java/com/bara/chessclock/data/AndroidAdapters.kt
new file mode 100644
index 0000000000000000000000000000000000000000..0d29d991786106ec7eb22ab99cfa58833297275c
--- /dev/null
+++ b/app/src/main/java/com/bara/chessclock/data/AndroidAdapters.kt
@@ -0,0 +1,67 @@
+package com.bara.chessclock.data
+
+import android.content.Context
+import android.os.Build
+import android.os.SystemClock
+import android.provider.Settings
+import com.bara.chessclock.core.BootIdSource
+import com.bara.chessclock.core.ClockStore
+import com.bara.chessclock.core.TimeSource
+import java.util.UUID
+
+/**
+ * Snapshot storage. `commit()` is used instead of `apply()`: the snapshot is written on ON_STOP,
+ * where the process may be killed immediately afterwards, and the payload is a few hundred bytes
+ * written only on state transitions.
+ */
+class PreferencesClockStore(context: Context) : ClockStore {
+
+    private val prefs = context.applicationContext
+        .getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    override fun read(): String? = prefs.getString(KEY_SNAPSHOT, null)
+
+    override fun write(text: String) {
+        val ok = prefs.edit().putString(KEY_SNAPSHOT, text).commit()
+        if (!ok) throw IllegalStateException("SharedPreferences commit failed")
+    }
+
+    private companion object {
+        const val PREFS_NAME = "chess_clock"
+        const val KEY_SNAPSHOT = "snapshot_v1"
+    }
+}
+
+/**
+ * `Settings.Global.BOOT_COUNT` changes on every device boot, which is exactly the discriminator
+ * needed before trusting a stored monotonic anchor.
+ *
+ * If it cannot be read (should not happen on API 26+), the fallback is a per-process random id:
+ * conservative, because a snapshot from another process will then be treated as "other boot" and
+ * the clock comes back paused rather than silently subtracting incomparable readings.
+ */
+class AndroidBootIdSource(private val context: Context) : BootIdSource {
+
+    private val fallbackId: String by lazy { "process:${UUID.randomUUID()}" }
+
+    override fun current(): String {
+        val count = try {
+            Settings.Global.getInt(
+                context.applicationContext.contentResolver,
+                Settings.Global.BOOT_COUNT,
+                -1,
+            )
+        } catch (e: RuntimeException) {
+            -1
+        }
+        return if (count >= 0) "boot:$count" else fallbackId
+    }
+
+    /** Exposed for the verification notes: which build the id belongs to. */
+    val buildFingerprint: String get() = Build.FINGERPRINT
+}
+
+/** Monotonic source: unaffected by date/time/timezone changes within one boot. */
+class ElapsedRealtimeSource : TimeSource {
+    override fun elapsedMs(): Long = SystemClock.elapsedRealtime()
+}
diff --git a/app/src/main/java/com/bara/chessclock/ui/ClockViewModel.kt b/app/src/main/java/com/bara/chessclock/ui/ClockViewModel.kt
new file mode 100644
index 0000000000000000000000000000000000000000..c17196007250750c6adea85d1c2748a66fa42a38
--- /dev/null
+++ b/app/src/main/java/com/bara/chessclock/ui/ClockViewModel.kt
@@ -0,0 +1,112 @@
+package com.bara.chessclock.ui
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.ViewModelProvider
+import androidx.lifecycle.viewModelScope
+import com.bara.chessclock.core.ClockController
+import com.bara.chessclock.core.ClockState
+import com.bara.chessclock.core.RestoreNotice
+import com.bara.chessclock.core.Screen
+import com.bara.chessclock.core.Side
+import com.bara.chessclock.core.TimeControl
+import com.bara.chessclock.data.AndroidBootIdSource
+import com.bara.chessclock.data.ElapsedRealtimeSource
+import com.bara.chessclock.data.PreferencesClockStore
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** Everything the Compose layer needs; nothing the clock rules live in. */
+data class ClockUiState(
+    val screen: Screen,
+    val clock: ClockState,
+    val nowElapsedMs: Long,
+    val notice: RestoreNotice,
+    val resetDialogOpen: Boolean,
+    val pendingNewGame: TimeControl?,
+)
+
+/**
+ * Thin Android shell around [ClockController]: it owns the lifecycle (ticker, ON_STOP snapshot)
+ * and exposes immutable UI state. All timing rules stay in the pure core.
+ *
+ * Surviving configuration changes is handled by the ViewModel itself; surviving process death is
+ * handled by the snapshot the controller writes — the ViewModel deliberately keeps no other truth.
+ */
+class ClockViewModel(application: Application) : AndroidViewModel(application) {
+
+    private val controller = ClockController(
+        store = PreferencesClockStore(application),
+        time = ElapsedRealtimeSource(),
+        bootId = AndroidBootIdSource(application),
+    )
+
+    private val _ui = MutableStateFlow(snapshotUi(controller.onFrame()))
+    val ui: StateFlow<ClockUiState> = _ui.asStateFlow()
+
+    private fun snapshotUi(now: Long): ClockUiState = ClockUiState(
+        screen = controller.screen,
+        clock = controller.state,
+        nowElapsedMs = now,
+        notice = controller.notice,
+        resetDialogOpen = controller.resetDialogOpen,
+        pendingNewGame = controller.pendingNewGameControl,
+    )
+
+    /** One display refresh; also the only place a timeout can be noticed without a tap. */
+    fun onTick() {
+        _ui.value = snapshotUi(controller.onFrame())
+    }
+
+    /** Called when the app comes back to the foreground (ON_START). */
+    fun onStart() {
+        _ui.value = snapshotUi(controller.onFrame())
+    }
+
+    /** Called from ON_STOP: last chance to persist before the process may be killed. */
+    fun onStop() {
+        controller.onStop()
+    }
+
+    fun tap(side: Side) = mutate { controller.tap(side) }
+
+    fun togglePause() = mutate { controller.togglePause() }
+
+    fun openResetDialog() = mutate { controller.openResetDialog() }
+
+    fun cancelResetDialog() = mutate { controller.cancelResetDialog() }
+
+    fun confirmResetDialog() = mutate { controller.confirmResetDialog() }
+
+    fun openSettings() = mutate { controller.openSettings() }
+
+    fun backToBoard() = mutate { controller.backToBoard() }
+
+    fun requestNewGame(control: TimeControl) = mutate { controller.requestNewGame(control) }
+
+    fun confirmNewGame() = mutate { controller.confirmNewGame() }
+
+    fun cancelNewGame() = mutate { controller.cancelNewGame() }
+
+    fun acknowledgeNotice() = mutate { controller.acknowledgeNotice() }
+
+    fun resetConfirmationMessage(): String = controller.resetConfirmationMessage()
+
+    fun newGameConfirmationMessage(): String = controller.newGameConfirmationMessage()
+
+    private inline fun mutate(block: () -> Unit) {
+        block()
+        _ui.value = snapshotUi(controller.onFrame())
+    }
+
+    @Suppress("unused")
+    private val scope = viewModelScope
+
+    class Factory(private val application: Application) : ViewModelProvider.Factory {
+        @Suppress("UNCHECKED_CAST")
+        override fun <T : ViewModel> create(modelClass: Class<T>): T =
+            ClockViewModel(application) as T
+    }
+}
diff --git a/app/src/test/java/com/bara/chessclock/core/ClockControllerTest.kt b/app/src/test/java/com/bara/chessclock/core/ClockControllerTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..f34f9e41205fa8d31d95c1e4c93d0195d5b0d939
--- /dev/null
+++ b/app/src/test/java/com/bara/chessclock/core/ClockControllerTest.kt
@@ -0,0 +1,384 @@
+package com.bara.chessclock.core
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** Test doubles: the controller talks only to these seams, so no Android/emulator is needed. */
+private class MemoryStore(var text: String? = null) : ClockStore {
+    var writes = 0
+    var failWrites = false
+    override fun read(): String? = text
+    override fun write(text: String) {
+        if (failWrites) throw IllegalStateException("disk full")
+        this.text = text
+        writes += 1
+    }
+}
+
+private class FakeTime(var now: Long = 0) : TimeSource {
+    override fun elapsedMs(): Long = now
+    fun advance(ms: Long) {
+        now += ms
+    }
+}
+
+private class FakeBoot(var id: String = "boot:1") : BootIdSource {
+    override fun current(): String = id
+}
+
+private fun controller(
+    store: ClockStore = MemoryStore(),
+    time: FakeTime = FakeTime(),
+    boot: FakeBoot = FakeBoot(),
+    default: TimeControl = TimeControl.PRESET_1_MIN,
+): ClockController = ClockController(store, time, boot, default, wallClockMs = { 1_700_000_000_000L })
+
+/**
+ * C / D / E acceptance cases driven through [ClockController] — the same object the UI uses.
+ * See docs/acceptance.md for the predicted values.
+ */
+class ClockControllerTest {
+
+    // ------------------------------------------------------------------ C. settings & reset
+
+    @Test
+    fun `C - a fresh install starts on settings and starts the configured game on request`() {
+        val c = controller()
+        assertEquals(Screen.SETTINGS, c.screen)
+        assertEquals(Phase.READY, c.state.phase)
+
+        c.requestNewGame(TimeControl.PRESET_5_MIN)
+        assertEquals(Screen.BOARD, c.screen)
+        assertEquals(Phase.READY, c.state.phase)
+        assertEquals(300_000, c.state.remainingMs(Side.ONE))
+        assertEquals(300_000, c.state.remainingMs(Side.TWO))
+        assertEquals(0, c.state.moves)
+        assertEquals(0, c.state.control.incrementMs)
+    }
+
+    @Test
+    fun `C - the 1 minute preset keeps a zero increment`() {
+        val c = controller()
+        c.requestNewGame(TimeControl.PRESET_1_MIN)
+        assertEquals(60_000, c.state.remainingMs(Side.ONE))
+        assertEquals(0, c.state.control.incrementMs)
+    }
+
+    @Test
+    fun `C - confirmed reset returns a 5 minute game to 5-00, zero moves, waiting for a tap`() {
+        val time = FakeTime()
+        val c = controller(time = time)
+        c.requestNewGame(TimeControl.PRESET_5_MIN)
+        c.tap(Side.TWO)
+        time.advance(4_000)
+        c.tap(Side.ONE)
+        time.advance(2_000)
+        assertEquals(1, c.state.moves)
+
+        c.openResetDialog()
+        assertEquals(true, c.resetDialogOpen)
+        assertEquals("双方恢复至 5:00，步数归零。", c.resetConfirmationMessage())
+        c.confirmResetDialog()
+
+        assertEquals(false, c.resetDialogOpen)
+        assertEquals(Phase.READY, c.state.phase)
+        assertEquals(0, c.state.moves)
+        assertEquals(300_000, c.state.remainingMs(Side.ONE))
+        assertEquals(300_000, c.state.remainingMs(Side.TWO))
+        assertNull(c.state.active)
+    }
+
+    @Test
+    fun `C - opening the reset dialog freezes the clock, cancelling restores the running side`() {
+        val time = FakeTime()
+        val c = controller(time = time)
+        c.requestNewGame(TimeControl.PRESET_5_MIN)
+        c.tap(Side.TWO)
+        time.advance(3_000)
+        c.tap(Side.ONE) // player two 297 000, player one running
+
+        c.openResetDialog()
+        assertEquals(Phase.PAUSED, c.state.phase)
+
+        // five seconds of reading the dialog must not cost anything
+        time.advance(5_000)
+        assertEquals(297_000, c.state.remainingAt(Side.TWO, time.now))
+        assertEquals(300_000, c.state.remainingAt(Side.ONE, time.now))
+
+        c.cancelResetDialog()
+        assertEquals(Phase.RUNNING, c.state.phase)
+        assertEquals(Side.ONE, c.state.active) // same side as before the dialog
+        assertEquals(1, c.state.moves)
+
+        time.advance(1_000)
+        assertEquals(299_000, c.state.remainingAt(Side.ONE, time.now))
+        assertEquals(297_000, c.state.remainingAt(Side.TWO, time.now))
+    }
+
+    @Test
+    fun `C - cancelling a reset that was opened while paused leaves the game paused`() {
+        val time = FakeTime()
+        val c = controller(time = time)
+        c.requestNewGame(TimeControl.PRESET_5_MIN)
+        c.tap(Side.TWO)
+        time.advance(1_000)
+        c.togglePause()
+        assertEquals(Phase.PAUSED, c.state.phase)
+
+        c.openResetDialog()
+        c.cancelResetDialog()
+        assertEquals(Phase.PAUSED, c.state.phase)
+        assertEquals(299_000, c.state.remainingMs(Side.TWO))
+    }
+
+    @Test
+    fun `C - tapping through the reset dialog is ignored`() {
+        val time = FakeTime()
+        val c = controller(time = time)
+        c.requestNewGame(TimeControl.PRESET_3_PLUS_2)
+        c.tap(Side.TWO)
+        time.advance(1_000)
+        c.openResetDialog()
+        val before = c.state
+        c.tap(Side.ONE)
+        assertEquals(before, c.state)
+        assertEquals(0, c.state.moves)
+    }
+
+    @Test
+    fun `C - changing the time control mid game needs confirmation and can be cancelled`() {
+        val time = FakeTime()
+        val c = controller(time = time)
+        c.requestNewGame(TimeControl.PRESET_5_MIN)
+        c.tap(Side.TWO)
+        time.advance(2_000)
+        c.tap(Side.ONE)
+
+        c.requestNewGame(TimeControl.PRESET_3_PLUS_2)
+        assertEquals(TimeControl.PRESET_3_PLUS_2, c.pendingNewGameControl)
+        assertEquals(Phase.PAUSED, c.state.phase) // frozen while the answer is pending
+        assertEquals(TimeControl.PRESET_5_MIN, c.state.control)
+        assertTrue(c.newGameConfirmationMessage().contains("3:00"))
+
+        c.cancelNewGame()
+        assertNull(c.pendingNewGameControl)
+        assertEquals(Phase.RUNNING, c.state.phase)
+        assertEquals(TimeControl.PRESET_5_MIN, c.state.control)
+        assertEquals(1, c.state.moves)
+
+        c.requestNewGame(TimeControl.PRESET_3_PLUS_2)
+        c.confirmNewGame()
+        assertNull(c.pendingNewGameControl)
+        assertEquals(Screen.BOARD, c.screen)
+        assertEquals(Phase.READY, c.state.phase)
+        assertEquals(TimeControl.PRESET_3_PLUS_2, c.state.control)
+        assertEquals(0, c.state.moves)
+        assertEquals(180_000, c.state.remainingMs(Side.ONE))
+    }
+
+    // ------------------------------------------------------------------ D. recovery
+
+    @Test
+    fun `D - a snapshot taken while running is fast-forwarded exactly once after process death`() {
+        val store = MemoryStore()
+        val time = FakeTime(now = 1_000)
+        val boot = FakeBoot("boot:9")
+        val first = controller(store, time, boot)
+        first.requestNewGame(TimeControl.PRESET_5_MIN)
+        first.tap(Side.TWO) // starts at 1 000
+        time.advance(5_000)
+        first.onStop() // snapshot written at 6 000, player two still running
+
+        // process death: a brand new controller over the same storage, 7 s later
+        time.advance(7_000)
+        val second = controller(store, time, boot)
+        assertEquals(Phase.RUNNING, second.state.phase)
+        assertEquals(Side.TWO, second.state.active)
+        assertEquals(300_000 - 12_000 - 0, second.state.remainingAt(Side.TWO, time.now))
+        assertEquals(0, second.state.moves)
+        assertEquals(Screen.BOARD, second.screen)
+
+        // restoring twice must not charge twice
+        val third = controller(store, time, boot)
+        assertEquals(second.state.remainingAt(Side.TWO, time.now), third.state.remainingAt(Side.TWO, time.now))
+    }
+
+    @Test
+    fun `D - a snapshot taken while paused deducts nothing on restore`() {
+        val store = MemoryStore()
+        val time = FakeTime(now = 0)
+        val boot = FakeBoot("boot:9")
+        val first = controller(store, time, boot)
+        first.requestNewGame(TimeControl.PRESET_5_MIN)
+        first.tap(Side.TWO)
+        time.advance(3_000)
+        first.togglePause()
+        first.onStop()
+
+        time.advance(60_000) // one minute in the background
+        val second = controller(store, time, boot)
+        assertEquals(Phase.PAUSED, second.state.phase)
+        assertEquals(297_000, second.state.remainingAt(Side.TWO, time.now))
+        assertEquals(Side.TWO, second.state.active)
+    }
+
+    @Test
+    fun `D - a snapshot taken before the first tap restores a ready board`() {
+        val store = MemoryStore()
+        val time = FakeTime()
+        val boot = FakeBoot("boot:9")
+        val first = controller(store, time, boot)
+        first.requestNewGame(TimeControl.PRESET_3_PLUS_2)
+        first.onStop()
+
+        time.advance(10_000)
+        val second = controller(store, time, boot)
+        assertEquals(Phase.READY, second.state.phase)
+        assertEquals(Screen.BOARD, second.screen) // lands where the user left off
+        assertEquals(TimeControl.PRESET_3_PLUS_2, second.state.control)
+        assertEquals(180_000, second.state.remainingMs(Side.ONE))
+    }
+
+    @Test
+    fun `D - after a reboot the game comes back paused with a notice instead of guessing`() {
+        val store = MemoryStore()
+        val time = FakeTime(now = 10_000)
+        val boot = FakeBoot("boot:9")
+        val first = controller(store, time, boot)
+        first.requestNewGame(TimeControl.PRESET_5_MIN)
+        first.tap(Side.ONE)
+        time.advance(4_000)
+        first.onStop()
+
+        boot.id = "boot:10" // device rebooted: elapsedRealtime restarted from ~0
+        time.now = 2_000
+        val second = controller(store, time, boot)
+        assertEquals(Phase.PAUSED, second.state.phase)
+        assertEquals(RestoreNotice.REBOOT_PAUSED, second.notice)
+        assertEquals(296_000, second.state.remainingMs(Side.ONE)) // only the 4 s observed before the save
+        assertEquals(Side.ONE, second.state.active)
+    }
+
+    @Test
+    fun `D - a corrupt snapshot is discarded and the app opens on settings`() {
+        val store = MemoryStore(text = "format=chessclock-snapshot\nversion=1\nphase=RUNNING\n")
+        val c = controller(store)
+        assertEquals(RestoreNotice.SNAPSHOT_DISCARDED, c.notice)
+        assertEquals(Screen.SETTINGS, c.screen)
+        assertEquals(Phase.READY, c.state.phase)
+        assertEquals(60_000, c.state.remainingMs(Side.ONE))
+        c.acknowledgeNotice()
+        assertEquals(RestoreNotice.NONE, c.notice)
+    }
+
+    @Test
+    fun `D - a failing store never breaks the clock in memory`() {
+        val store = MemoryStore()
+        store.failWrites = true
+        val time = FakeTime()
+        val c = controller(store, time)
+        c.requestNewGame(TimeControl.PRESET_1_MIN)
+        c.tap(Side.TWO)
+        time.advance(1_000)
+        assertEquals(Phase.RUNNING, c.state.phase) // still usable
+        assertNotNull(c.lastStorageError) // and the failure is not hidden
+        assertEquals(0, c.persistCount)
+    }
+
+    // ------------------------------------------------------------------ persistence policy
+
+    @Test
+    fun `frames do not write to disk`() {
+        val store = MemoryStore()
+        val time = FakeTime()
+        val c = controller(store, time)
+        c.requestNewGame(TimeControl.PRESET_5_MIN)
+        val writesAfterStart = store.writes
+        c.tap(Side.TWO)
+        val writesAfterTap = store.writes
+        repeat(120) { // ~10 s of 80 ms frames
+            time.advance(80)
+            c.onFrame()
+        }
+        // 120 frames over 9.6 s: at most the 10 s throttle may fire, never one write per frame
+        assertTrue(store.writes - writesAfterTap <= 1)
+        assertTrue(store.writes >= writesAfterStart)
+    }
+
+    @Test
+    fun `a throttled safety snapshot happens about every ten seconds while running`() {
+        val store = MemoryStore()
+        val time = FakeTime()
+        val c = controller(store, time)
+        c.requestNewGame(TimeControl.PRESET_10_MIN)
+        c.tap(Side.TWO)
+        val baseline = store.writes
+        repeat(60) {
+            time.advance(1_000)
+            c.onFrame()
+        }
+        assertEquals(baseline + 6, store.writes) // one per 10 s
+    }
+
+    @Test
+    fun `onStop always writes and a timeout is noticed without any tap`() {
+        val store = MemoryStore()
+        val time = FakeTime()
+        val c = controller(store, time)
+        c.requestNewGame(TimeControl.PRESET_1_MIN)
+        c.tap(Side.ONE)
+        time.advance(61_000)
+        c.onFrame()
+        assertEquals(Phase.FINISHED, c.state.phase)
+        assertEquals(Side.ONE, c.state.flagged)
+        val before = store.writes
+        c.onStop()
+        assertEquals(before + 1, store.writes)
+        assertEquals(Phase.FINISHED, ClockSnapshotCodec.decode(store.text)!!.state.phase)
+    }
+
+    // ------------------------------------------------------------------ navigation
+
+    @Test
+    fun `E - going to settings pauses and coming back resumes the same side`() {
+        val time = FakeTime()
+        val c = controller(time = time)
+        c.requestNewGame(TimeControl.PRESET_5_MIN)
+        c.tap(Side.TWO)
+        time.advance(2_000)
+
+        c.openSettings()
+        assertEquals(Screen.SETTINGS, c.screen)
+        assertEquals(Phase.PAUSED, c.state.phase)
+        time.advance(30_000) // time spent adjusting settings
+        assertEquals(298_000, c.state.remainingAt(Side.TWO, time.now))
+
+        c.tap(Side.ONE) // taps on the board are not possible from settings, and are ignored anyway
+        assertEquals(Screen.SETTINGS, c.screen)
+        assertEquals(0, c.state.moves)
+
+        c.backToBoard()
+        assertEquals(Screen.BOARD, c.screen)
+        assertEquals(Phase.RUNNING, c.state.phase)
+        assertEquals(Side.TWO, c.state.active)
+        assertEquals(298_000, c.state.remainingAt(Side.TWO, time.now))
+    }
+
+    @Test
+    fun `E - a 30 second gap with no refresh is charged once, not twice`() {
+        val time = FakeTime()
+        val c = controller(time = time)
+        c.requestNewGame(TimeControl.PRESET_5_MIN)
+        c.tap(Side.TWO)
+        time.advance(30_000) // app was not rendering (screen off)
+        c.onFrame() // the UI refreshes on return; no extra settle path exists
+        assertEquals(270_000, c.state.remainingAt(Side.TWO, time.now))
+        c.tap(Side.ONE)
+        assertEquals(270_000, c.state.remainingMs(Side.TWO))
+        assertEquals(1, c.state.moves)
+        assertEquals(300_000, c.state.remainingMs(Side.ONE))
+    }
+}
